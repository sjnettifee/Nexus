// nexus/src/gpu/shaders/add_residual.comp — In-place residual add: x += y
// Binding 0 = x [n] f32 (in/out)
// Binding 1 = y [n] f32 (read)

#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer XBuf { float x[]; };
layout(set = 0, binding = 1) readonly buffer YBuf { float y[]; };

layout(push_constant) uniform PC { uint n; uint pad0; uint pad1; uint pad2; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) x[i] += y[i];
}
