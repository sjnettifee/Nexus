// nexus/src/gpu/shaders/silu_mul.comp — SiLU activation × gate
//
// Computes: gate[i] = gate[i] * sigmoid(gate[i]) * up[i]  (SiLU(gate) × up)
// Result written back into gate buffer.
// Binding 0 = gate [n] f32 (in/out)
// Binding 1 = up   [n] f32 (read-only)
// Push constant: n_elements

#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer GateBuf { float gate[]; };
layout(set = 0, binding = 1) readonly buffer UpBuf { float up[]; };

layout(push_constant) uniform PC { uint n; uint pad0; uint pad1; uint pad2; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float g = gate[i];
    float silu = g / (1.0 + exp(-g));  // g * sigmoid(g)
    gate[i] = silu * up[i];
}
