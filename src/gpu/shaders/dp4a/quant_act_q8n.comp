// nexus/src/gpu/shaders/quant_act_q8n.comp -- quantise a decode activation vector to int8 for the K-quant dot-product matvec kernels
//
// x  : f32 [n_blocks * 32]
// xq : uint [n_blocks * 8]   int8 values packed 4 per word in NATURAL order (word w holds elements 4w..4w+3, element 4w in the low byte)
// xs : f32 [n_blocks]        scale per 32 values: x ~= q * scale, q in [-127, 127]
// Dispatch: ceil(n_blocks / 32) groups of 32 threads (one thread per 32-value block).  Push constants: n_blocks.
#version 450
layout(local_size_x = 32) in;
layout(set = 0, binding = 0) readonly  buffer XBuf  { vec4 x4[];  };
layout(set = 0, binding = 1) writeonly buffer QBuf  { uint xq[];  };
layout(set = 0, binding = 2) writeonly buffer SBuf  { float xs[]; };
layout(push_constant) uniform PC { uint n_blocks; uint p0; uint p1; uint p2; } pc;
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n_blocks) return;
    vec4 v[8];
    float amax = 0.0;
    for (uint k = 0u; k < 8u; ++k) { v[k] = x4[i * 8u + k]; amax = max(amax, max(max(abs(v[k].x), abs(v[k].y)), max(abs(v[k].z), abs(v[k].w)))); }
    const float inv = (amax > 0.0) ? 127.0 / amax : 0.0;
    xs[i] = amax / 127.0;
    for (uint k = 0u; k < 8u; ++k) {
        const ivec4 q = clamp(ivec4(roundEven(v[k] * inv)), ivec4(-127), ivec4(127));
        xq[i * 8u + k] = (uint(q.x) & 0xFFu) | ((uint(q.y) & 0xFFu) << 8u) | ((uint(q.z) & 0xFFu) << 16u) | ((uint(q.w) & 0xFFu) << 24u);
    }
}
