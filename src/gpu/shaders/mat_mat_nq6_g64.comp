// nexus/src/gpu/shaders/mat_mat_nq6_g64.comp -- Nexus native NQ6_G64, prompt reading (matrix x many tokens), large-tile kernel
// GENERATED by tools/gen_mm_shaders.py from one skeleton (same design as mat_mat_nq4_g64_big.comp):
//   Y[token, row] = dot(W[row, :], X[token, :])
// A workgroup of 256 threads computes a 128-row x 128-token tile of Y; every thread owns an 8 x 8 register tile (64 accumulators).  The columns are
// walked 32 at a time; the next step's global loads are issued BEFORE the current step's maths so memory latency overlaps with the multiply-adds.
// Weights are decoded to float in shared memory.  Columns beyond in_cols read as zero, so any in_cols that is a multiple of 4 works.
// DISPATCH: groups = (ceil(out_rows/128), ceil(n_tokens/128)).  Pipeline::mm_tile_rows / mm_tile_toks must be 128 / 128.
// Push constants: out_rows, in_cols, n_blocks_per_row, n_tokens   (n_blocks_per_row counts groups of 64 weights (ceil(in_cols/64)))

#version 450
#extension GL_EXT_control_flow_attributes : enable
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer WeightBuf  { uint  W[];  };
layout(set = 0, binding = 1) readonly buffer InputBuf   { vec4  x4[]; };
layout(set = 0, binding = 2) writeonly buffer OutputBuf { float y[];  };

layout(push_constant) uniform PC {
    uint out_rows;
    uint in_cols;
    uint n_blocks_per_row;
    uint n_tokens;
} pc;

const uint BM  = 128u;
const uint BN  = 128u;
const uint BK  = 32u;
const uint SPB = 2u;            // 32-column steps per weight block
const uint BLK_BYTES = 50u;

shared vec4 Ws4[BK * 32u];   // [k][row/4]  decoded weights
shared vec4 Xs4[BK * 32u];   // [k][tok/4]  inputs

uint last_word;
float f16_to_f32(uint h){ return unpackHalf2x16(h & 0xFFFFu).x; }
uint ld32(uint o) {                 // 4 bytes at even byte offset o (clamped to the end of the matrix)
    const uint w = o >> 2u;
    const uint a = W[min(w, last_word)];
    if ((o & 2u) == 0u) return a;
    return (a >> 16u) | (W[min(w + 1u, last_word)] << 16u);
}
uint ld8(uint o) { return (W[min(o >> 2u, last_word)] >> ((o & 3u) * 8u)) & 255u; }

// register-resident prefetch of the next step
uint  p_w[4];
uint  p_h[4];
float p_a, p_b;
uint  p_ss;
vec4  p_x[4];

void load_step(uint s, uint row, uint tok, uint half_) {
    const uint nb = pc.n_blocks_per_row;
    const uint g  = s / SPB;
    const uint ss = s % SPB;
    p_ss = ss; p_a = 0.0; p_b = 0.0;
    [[unroll]] for (uint i = 0u; i < 4u; ++i) p_w[i] = 0u;
    [[unroll]] for (uint i = 0u; i < 4u; ++i) p_h[i] = 0u;
    if (row < pc.out_rows) {
        const uint rec = (row * nb + g) * 50u;
        p_a = f16_to_f32(W[rec >> 2u] >> ((rec & 2u) * 8u));
        const uint o = rec + 2u + (2u * ss + half_) * 12u;
        [[unroll]] for (uint i = 0u; i < 3u; ++i) p_w[i] = ld32(o + 4u * i);
    }
    const uint c = s * BK + half_ * 16u;
    if (tok < pc.n_tokens && c < pc.in_cols) {
        const uint base = (tok * pc.in_cols + c) >> 2u;
        p_x[0] = x4[base]; p_x[1] = x4[base + 1u]; p_x[2] = x4[base + 2u]; p_x[3] = x4[base + 3u];
    } else {
        p_x[0] = vec4(0.0); p_x[1] = vec4(0.0); p_x[2] = vec4(0.0); p_x[3] = vec4(0.0);
    }
}

float decode_w(uint k) {            // weight k (0..15) of this thread's slice of the current step
    const uint bit = k * 6u, wi = bit >> 5u, sh = bit & 31u;
    uint v = p_w[wi] >> sh;
    if (sh + 6u > 32u) v |= p_w[wi + 1u] << (32u - sh);
    return (float(v & 63u) - 32.0) * p_a;
}

void main() {
    const uint tid  = gl_LocalInvocationID.x;
    const uint row0 = gl_WorkGroupID.x * BM;
    const uint tok0 = gl_WorkGroupID.y * BN;
    last_word = (pc.out_rows * pc.n_blocks_per_row * BLK_BYTES + 3u) / 4u - 1u;

    const uint ld_item = tid >> 1u;
    const uint ld_half = tid & 1u;
    const uint ld_row  = row0 + ld_item;
    const uint ld_tok  = tok0 + ld_item;

    const uint tx = tid & 15u;
    const uint ty = tid >> 4u;

    float acc[8][8];
    [[unroll]] for (uint i = 0u; i < 8u; ++i) [[unroll]] for (uint j = 0u; j < 8u; ++j) acc[i][j] = 0.0;

    const uint steps = pc.n_blocks_per_row * SPB;
    load_step(0u, ld_row, ld_tok, ld_half);

    for (uint s = 0u; s < steps; ++s) {
        {
            [[unroll]] for (uint k = 0u; k < 16u; ++k)
                Ws4[(ld_half * 16u + k) * 32u + (ld_item >> 2u)][ld_item & 3u] = decode_w(k);
            [[unroll]] for (uint i = 0u; i < 4u; ++i)
                [[unroll]] for (uint c = 0u; c < 4u; ++c)
                    Xs4[(ld_half * 16u + i * 4u + c) * 32u + (ld_item >> 2u)][ld_item & 3u] = p_x[i][c];
        }
        barrier();

        if (s + 1u < steps) load_step(s + 1u, ld_row, ld_tok, ld_half);

        for (uint k = 0u; k < BK; ++k) {
            const vec4 wa = Ws4[k * 32u + tx];
            const vec4 wb = Ws4[k * 32u + 16u + tx];
            const vec4 xa = Xs4[k * 32u + ty];
            const vec4 xb = Xs4[k * 32u + 16u + ty];
            const float w[8] = float[8](wa.x, wa.y, wa.z, wa.w, wb.x, wb.y, wb.z, wb.w);
            const float x[8] = float[8](xa.x, xa.y, xa.z, xa.w, xb.x, xb.y, xb.z, xb.w);
            [[unroll]] for (uint i = 0u; i < 8u; ++i)
                [[unroll]] for (uint j = 0u; j < 8u; ++j)
                    acc[i][j] += w[i] * x[j];
        }
        barrier();
    }

    [[unroll]] for (uint j = 0u; j < 8u; ++j) {
        const uint tok = tok0 + ((j < 4u) ? (ty * 4u + j) : (64u + ty * 4u + (j - 4u)));
        if (tok >= pc.n_tokens) continue;
        [[unroll]] for (uint i = 0u; i < 8u; ++i) {
            const uint r = row0 + ((i < 4u) ? (tx * 4u + i) : (64u + tx * 4u + (i - 4u)));
            if (r < pc.out_rows) y[tok * pc.out_rows + r] = acc[i][j];
        }
    }
}
